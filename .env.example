# Copy to server/.env and add your API keys for live AI features.
# Keep real keys in server/.env; never add them to client/ or commit them.

# TinyFish Web Agent: powers the live research call and the NeuroNutri recipe scraper.
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Google Gemini: powers AI personal insights and learning-hub explainers.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the Gemini model. Defaults to gemini-2.5-flash
# (the server falls back to gemini-3.8-flash if a model is retired).
GEMINI_MODEL=gemini-2.5-flash

PORT=3001
DATABASE_PATH=./data/neurotrack.sqlite
