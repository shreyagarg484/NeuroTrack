{
  "name": "neurotrack",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install && npm --prefix client install && npm --prefix server install",
    "build": "npm run build --workspace=client",
    "start": "npm --prefix server start",
    "test": "npm --workspace server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
